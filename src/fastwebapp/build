#!/usr/bin/env bash
# build - compile the Go server into ./fastwebapp. Incremental (go's own cache); BUILD_FORCE=1 ./build rebuilds everything.
# No arguments. `run` calls this script.
set -eu
cd "$(dirname "$(readlink -f "$0")")"
[ $# -eq 0 ] || { echo "build: takes no arguments (BUILD_FORCE=1 in the environment forces a full rebuild)" >&2; exit 2; }
command -v go > /dev/null || { echo "build: go not found" >&2; exit 1; }
go build ${BUILD_FORCE:+-a} -o fastwebapp ./cmd/fastwebapp
echo "built: fastwebapp/fastwebapp"
