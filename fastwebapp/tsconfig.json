{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true
  },
  "include": [
    "frontend/src",
    "gems/layout",
    "gems/render3d",
    "gems/spring",
    "gems/searchbar",
    "gems/progressbar",
    "gems/theme",
    "gems/charts",
    "gems/export",
    "gems/pagination",
    "gems/datatable",
    "gems/notifications",
    "gems/upload",
    "gems/chat"
  ]
}
